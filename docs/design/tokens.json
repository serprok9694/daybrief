{
  "$description": "daybrief design tokens v1. Source of truth: tokens.css (same values). Contrast ratios measured on the worst-case scene for each theme.",
  "font": {
    "family": "Manrope",
    "fallback": ["-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
    "weights": [400, 500, 700]
  },
  "type": {
    "greeting":    { "size": 44, "lineHeight": 52, "weight": 700, "letterSpacing": "-0.02em", "mobile": { "size": 30, "lineHeight": 36 } },
    "summary":     { "size": 26, "lineHeight": 38, "weight": 500, "letterSpacing": "-0.01em", "mobile": { "size": 20, "lineHeight": 29 } },
    "idea":        { "size": 22, "lineHeight": 30, "weight": 700, "letterSpacing": "-0.01em", "mobile": { "size": 19, "lineHeight": 27 } },
    "widgetTitle": { "size": 17, "lineHeight": 24, "weight": 700 },
    "body":        { "size": 15, "lineHeight": 22, "weight": 500 },
    "secondary":   { "size": 13, "lineHeight": 18, "weight": 500 },
    "caption":     { "size": 12, "lineHeight": 16, "weight": 700 }
  },
  "radius": { "sheet": 40, "sheetMobile": 32, "card": 28, "row": 16, "pill": 999 },
  "space": [4, 8, 12, 16, 20, 24, 32, 44],
  "layout": {
    "mobileBreakpoint": 700,
    "railWidth": 0,
    "pagePadding": { "desktop": [24, 40], "mobile": [12, 12] },
    "sheetPadding": { "desktop": 44, "mobile": 16 },
    "cardPadding": { "desktop": 22, "mobile": 18 },
    "gridGap": { "desktop": 20, "mobile": 14 },
    "gridMinColumn": 340,
    "topBarHeight": { "desktop": 64, "mobile": 60 },
    "commandBar": { "height": 48, "maxWidth": 560, "mobileDockHeight": 60, "mobileDockOffset": 12 },
    "hitTarget": 44
  },
  "motion": {
    "skeleton": "1.6s ease-in-out infinite",
    "orbBreathe": "5s ease-in-out infinite, scale 1 → 1.07",
    "refreshSpin": "1s linear infinite",
    "reducedMotion": "disable all three"
  },
  "themes": {
    "light": {
      "ink": "#1F1B18", "ink2": "#4A423B", "ink3": "#5A5149",
      "accent": "#E4572A", "accentInk": "#8F2A06", "accentSoft": "rgba(228,87,42,0.12)",
      "accentSolid": "#B93A12", "onAccent": "#FFFFFF",
      "fill": "rgba(31,27,24,0.06)", "fill2": "rgba(31,27,24,0.10)", "line": "rgba(31,27,24,0.18)",
      "buttonPrimary": { "bg": "#17130F", "ink": "#FFFFFF" },
      "buttonSecondary": { "bg": "rgba(255,255,255,0.75)", "ink": "#1F1B18", "stroke": "rgba(31,27,24,0.14)" },
      "field": { "bg": "rgba(255,255,255,0.72)", "stroke": "rgba(31,27,24,0.12)" },
      "skeleton": { "a": "rgba(31,27,24,0.07)", "b": "rgba(31,27,24,0.14)" },
      "avatar": ["#E9D5BC", "#D5DBC6", "#DAD5CE", "#EBCFC4"],
      "toast": { "bg": "#17130F", "ink": "#FFFFFF" },
      "glass": {
        "sheet": { "bg": "rgba(255,250,244,0.56)", "blur": 40, "saturate": 1.5, "stroke": "rgba(255,255,255,0.70)", "shadow": "0 40px 80px -36px rgba(45,28,12,0.50)" },
        "card":  { "bg": "rgba(255,252,248,0.62)", "blur": 24, "saturate": 1.5, "stroke": "rgba(255,255,255,0.80)", "shadow": "0 14px 32px -18px rgba(60,38,18,0.35)" },
        "highlight": "inset 0 1px 0 rgba(255,255,255,0.85)",
        "lite": { "sheetBg": "rgba(255,250,244,0.84)", "cardBg": "rgba(255,252,248,0.88)", "blurSheet": 10, "blurCard": 6 }
      },
      "contrast": { "ink": 11.7, "ink2": 6.8, "ink3": 5.3, "accentInkOnSoft": 5.1, "onAccentSolid": 5.7, "buttonPrimary": 18.5 }
    },
    "dark": {
      "ink": "#F6F0E9", "ink2": "#DDD3C8", "ink3": "#C4B9AD",
      "accent": "#FF8A57", "accentInk": "#FFB08A", "accentSoft": "rgba(255,138,87,0.14)",
      "accentSolid": "#FF9A6A", "onAccent": "#17130F",
      "fill": "rgba(255,255,255,0.07)", "fill2": "rgba(255,255,255,0.12)", "line": "rgba(255,255,255,0.22)",
      "buttonPrimary": { "bg": "#F6F0E9", "ink": "#17130F" },
      "buttonSecondary": { "bg": "rgba(255,255,255,0.10)", "ink": "#F6F0E9", "stroke": "rgba(255,255,255,0.20)" },
      "field": { "bg": "rgba(255,255,255,0.08)", "stroke": "rgba(255,255,255,0.16)" },
      "skeleton": { "a": "rgba(255,255,255,0.07)", "b": "rgba(255,255,255,0.16)" },
      "avatar": ["#5A4A3C", "#44503F", "#4B4741", "#5C4038"],
      "toast": { "bg": "#F6F0E9", "ink": "#17130F" },
      "glass": {
        "sheet": { "bg": "rgba(34,28,24,0.72)", "blur": 40, "saturate": 1.4, "stroke": "rgba(255,255,255,0.14)", "shadow": "0 40px 90px -30px rgba(0,0,0,0.70)" },
        "card":  { "bg": "rgba(52,44,38,0.60)", "blur": 24, "saturate": 1.4, "stroke": "rgba(255,255,255,0.12)", "shadow": "0 16px 36px -18px rgba(0,0,0,0.60)" },
        "highlight": "inset 0 1px 0 rgba(255,255,255,0.14)",
        "lite": { "sheetBg": "rgba(34,28,24,0.88)", "cardBg": "rgba(52,44,38,0.82)", "blurSheet": 10, "blurCard": 6 }
      },
      "contrast": { "ink": 9.1, "ink2": 7.0, "ink3": 5.4, "accentInkOnSoft": 4.8, "onAccentSolid": 8.9, "buttonPrimary": 16.3 }
    }
  },
  "scenes": {
    "$note": "CSS stand-ins until the interior photos are chosen; the photo goes into --scene-photo.",
    "morning": { "hours": "05-11", "wall": ["#EAD9C2", "#D8BF9E"], "glow": "rgba(255,244,222,0.95)", "wood": "#B58659", "floor": "#B48A62" },
    "day":     { "hours": "11-17", "wall": ["#F2EADF", "#E3D5C2"], "glow": "rgba(255,255,255,0.95)", "wood": "#C9A478", "floor": "#CBA77D" },
    "evening": { "hours": "17-22", "wall": ["#D9A57C", "#8E5F48"], "glow": "rgba(255,176,112,0.85)", "wood": "#6F4630", "floor": "#6A4430" },
    "night":   { "hours": "22-05", "wall": ["#2E2723", "#171311"], "glow": "rgba(255,181,102,0.28)", "wood": "#2B1E17", "floor": "#1E1511" }
  }
}
