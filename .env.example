# Master list of local secrets (T0). Copy to .env; never commit .env.
# Each app reads its own subset: see apps/app/.env.example and apps/api/.env.example.

# Supabase
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# API: background sync (M1/T3). openssl rand -base64 32; the same value goes into
# Supabase Vault. Unset = POST /internal/sync answers 503.
SYNC_SECRET=
