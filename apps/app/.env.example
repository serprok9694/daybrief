# Public values only: everything prefixed EXPO_PUBLIC_ ends up in the client bundle.
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dev only: a fake signed-in session and /me profile, to view app screens without Google.
# Ignored in production builds. Never set it in Vercel.
# EXPO_PUBLIC_DEV_MOCK_AUTH=1
